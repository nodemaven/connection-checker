# Copy to .env and fill in. NEVER commit the filled .env.

# ── Your domains (public, behind your TLS reverse proxy) ─────────────────────
TURN_HOST=turn.example.com          # coturn (STUN/TURN) hostname
# api.example.com   -> credentials service (:8006)   set ALLOWED_ORIGIN below
# probe.example.com -> http3-probe service (:8005)

# ── Secrets (generate fresh, never reuse) ────────────────────────────────────
TURN_STATIC_AUTH_SECRET=            # openssl rand -hex 32  (also in turnserver.conf)
REDIS_PASSWORD=                     # openssl rand -hex 24
TURN_READBACK_SECRET=               # openssl rand -hex 32

# ── Options ──────────────────────────────────────────────────────────────────
TURN_PORT=3478
# CORS origin the credentials API allows. Set to your frontend's exact origin
# in production (e.g. https://checker.example.com) instead of "*".
ALLOWED_ORIGIN=*
