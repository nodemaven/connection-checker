# Copy to .env on the box. Never commit the filled file.

# Shared secret for TURN REST auth. MUST match `static-auth-secret` in
# turnserver.conf and the TURN_SECRET the credentials service signs with.
# Generate:  openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=

# Password for the local allocation store (redis on 127.0.0.1:6380).
# Generate:  openssl rand -hex 24
REDIS_PASSWORD=

# Shared secret for the turn-readback service, used by the credentials service
# to read back an allocation's observed IP. Separate from TURN_STATIC_AUTH_SECRET
# on purpose — a different capability than minting a credential.
# Generate:  openssl rand -hex 32
TURN_READBACK_SECRET=
